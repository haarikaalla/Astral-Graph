# ============ AstralGraph configuration ============
# Copy to .env and fill in. Do not commit real credentials.

# ---- LLM (required for full agent reasoning) ----
ANTHROPIC_API_KEY=sk-ant-...
ASTRAL_MODEL=claude-sonnet-4-20250514
ASTRAL_FAST_MODEL=claude-3-5-haiku-20241022
ASTRAL_MAX_TOKENS=2048
ASTRAL_TEMPERATURE=0.0

# ---- Serving ----
# Comma-separated browser origins allowed to call the API.
# Use * only for a local throwaway demo.
ASTRAL_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ---- NASA (free, instant key at https://api.nasa.gov) ----
# DEMO_KEY works but is heavily rate-limited.
NASA_API_KEY=DEMO_KEY

# ---- Brave Search MCP server ----
# Leave blank to disable that server.
BRAVE_API_KEY=

# ---- Official MCP servers (Node.js required: npx) ----
ASTRAL_ENABLE_NODE_MCP_SERVERS=true
ASTRAL_FS_ROOT=./workspace_data

# ---- Knowledge graph ----
# Leave NEO4J_URI blank to use the in-process NetworkX backend.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- RAG ----
ASTRAL_CHROMA_DIR=./storage/chroma
ASTRAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
ASTRAL_RAG_TOP_K=5

# ---- Guardrails / budgets ----
ASTRAL_MAX_TOOL_CALLS_PER_SESSION=24
ASTRAL_MAX_RETRIES_PER_AGENT=2
ASTRAL_MAX_AGENT_SECONDS=90
ASTRAL_GROUNDING_THRESHOLD=0.60

# ---- Observability (optional) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
ASTRAL_LOG_LEVEL=INFO
ASTRAL_LOG_DIR=./storage/logs
